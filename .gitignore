# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Secrets & Environment Variables (DO NOT COMMIT SENSITIVE SECRETS)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject

# User Generated Uploads (Keep folder structure, ignore contents)
app/static/uploads/plant/*
app/static/uploads/crop/*
app/static/uploads/skin/*
app/static/uploads/xray/*
app/static/uploads/blood_reports/*
!app/static/uploads/plant/.gitkeep
!app/static/uploads/crop/.gitkeep
!app/static/uploads/skin/.gitkeep
!app/static/uploads/xray/.gitkeep
!app/static/uploads/blood_reports/.gitkeep

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & SQLite local test files
*.sqlite3
*.db

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

